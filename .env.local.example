# Copy to .env.local (gitignored). Used only by `npm run deploy`.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com,kid@gmail.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Optional: Google Health (Fitbit) connection. Client ID only; the secret goes in SSM, never in this file (see README).
GOOGLE_HEALTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Optional: verified SES sender for gift price-drop emails (planner). Without it alerts are only logged.
PRICE_ALERT_FROM=alerts@example.com

# Monthly cost alert for Gravity (resources tagged app=gravity). Optional; no budget without ALERT_EMAIL.
ALERT_EMAIL=you@example.com
MONTHLY_BUDGET_USD=5
