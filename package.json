{
  "name": "gravity",
  "private": true,
  "version": "0.1.0",
  "description": "Private family dashboard with microservices",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "brand": "tsx scripts/brand-assets.ts",
    "allowlist": "tsx scripts/allowlist.ts",
    "local": "concurrently -k -n api,web -c cyan,magenta \"npm:local:api\" \"npm:local:web\"",
    "local:api": "tsx watch scripts/local-server.ts",
    "local:web": "npm run dev -w apps/web",
    "local:reset": "node -e \"require('fs').rmSync('.gravity-local',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "deploy": "npm run build -w apps/web && npm run deploy -w infra",
    "synth": "npm run build -w apps/web && npm run synth -w infra",
    "verify": "npm run typecheck && vitest run && playwright test",
    "tandoor:export": "tsx scripts/tandoor-export.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
